# PR-001: copy to android/key.properties (git-ignored) and fill in. Never commit the real file or the keystore.
# Create an upload key once, for example:
#   keytool -genkey -v -keystore C:\path\outside\repo\numaya-upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=upload
storeFile=C:\path\outside\repo\numaya-upload.jks
