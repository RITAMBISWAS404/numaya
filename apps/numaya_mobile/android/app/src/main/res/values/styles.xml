<?xml version="1.0" encoding="utf-8"?>
<!-- Numaya is light only (ThemeMode.light), so the night variants match the day ones. The bars are
     transparent with dark icons where the API level allows; Flutter keeps them so (AppSystemUi). -->
<resources>
    <!-- API 24-25: dark navigation-bar icons are not available, so the navigation bar keeps the
         system's dark bar; the status bar is transparent with dark icons. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/numaya_canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
