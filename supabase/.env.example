# Copy to supabase/.env.local (git-ignored) and fill in. Never paste these values into chat.
# Supabase dashboard > Project Settings > API Keys / Data API / Database > Connect.
SUPABASE_PROJECT_REF=
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...): the only key that goes into the Flutter app.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...): server-side tests and tools only. Never in Flutter or Git.
SUPABASE_SECRET_KEY=
# Database password chosen when creating the project (used by migrations and backups).
SUPABASE_DB_PASSWORD=
# Session pooler connection string (IPv4), from Connect > Session pooler, with the password filled in.
SUPABASE_DB_URL=
# Personal access token (Account > Access Tokens). Optional: migrations use SUPABASE_DB_URL.
SUPABASE_ACCESS_TOKEN=
# Test phone numbers configured in Auth > Providers > Phone (international, no +), e.g. 919000000001=123456
NUMAYA_TEST_PHONE_A=
NUMAYA_TEST_OTP_A=
NUMAYA_TEST_PHONE_B=
NUMAYA_TEST_OTP_B=
# Must stay "development": activate.mjs and db_push.mjs refuse anything else.
NUMAYA_ENVIRONMENT=development

# --- Optional (each group all-or-nothing). See docs/backend/MANUAL_SETUP.md. ---
# Staff account for scripts/staff.mjs (email/password user given a role in private.staff_members).
NUMAYA_STAFF_EMAIL=
NUMAYA_STAFF_PASSWORD=
# Backup encryption key: 32 random bytes, base64. Keep a copy OUTSIDE this machine.
NUMAYA_BACKUP_KEY=
# Firebase Cloud Messaging: service-account key JSON, base64 (push worker). Leave empty = push disabled.
FCM_SERVICE_ACCOUNT_JSON=
# Store verification (Edge Function secrets, pushed with activate.mjs --with-function-secrets).
# STORE_VERIFICATION_ENABLED is NOT read from this file: enabling it is a manual step.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PUBSUB_PUSH_AUDIENCE=
GOOGLE_PUBSUB_PUSH_SERVICE_ACCOUNT=
APPLE_BUNDLE_ID=
APPLE_ROOT_CA_G3_SHA256=
