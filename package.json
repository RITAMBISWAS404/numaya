{
  "name": "numaya-onboarding",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run tokens:check && npm run icons:check && vite build",
    "preview": "vite preview",
    "tokens": "node scripts/tokens.mjs",
    "tokens:check": "node scripts/tokens.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/smoke.mjs && node tests/e2e/product.mjs && node tests/e2e/experiment-tiimo.mjs && node tests/e2e/experiment-liquid-glass.mjs",
    "check": "npm run tokens:check && npm run icons:check && npm test && vite build",
    "test:a11y": "node tests/e2e/a11y.mjs",
    "gallery": "node scripts/gallery.mjs",
    "illustrations": "node scripts/illustration-catalog.mjs",
    "icons": "node scripts/icons.mjs",
    "icons:check": "node scripts/icons.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@material-symbols/svg-500": "0.47.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "4.14.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.56.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
