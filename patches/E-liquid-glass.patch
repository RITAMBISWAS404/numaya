diff --git a/src/flows/flows.css b/src/flows/flows.css
index 7648a29..548b3b7 100644
--- a/src/flows/flows.css
+++ b/src/flows/flows.css
@@ -153,13 +153,20 @@ body {
   padding: var(--space-3) var(--layout-gutter) calc(var(--safe-bottom) + var(--space-2));
 }
 
+/* Liquid Glass: the tab bar floats over the scrolling body, so content passes under the glass. The
+   body reserves the bar's height so the last item and the Discover card still clear it at rest. */
+.fl-screen {
+  position: relative;
+}
+
 .fl-screen .tab-bar {
-  flex: none;
+  position: absolute;
+  inset: auto 0 0;
+  z-index: 2;
 }
 
-/* Tab roots: the floating bar sits below the content; the body needs less bottom padding. */
 .fl-screen__body:has(+ .tab-bar) {
-  padding-bottom: var(--space-4);
+  padding-bottom: calc(var(--tab-bar-height) + var(--space-2) + var(--safe-bottom) + var(--space-4));
 }
 
 .fl-stack {
@@ -563,7 +570,7 @@ body {
 
 /* The profile: photo card 8px from the edges filling the viewport, then section cards. */
 .fl-screen--discover .fl-screen__body {
-  padding: 0 var(--layout-gutter-tight) var(--space-4);
+  padding: 0 var(--layout-gutter-tight) calc(var(--tab-bar-height) + var(--space-2) + var(--safe-bottom) + var(--space-4));
   container-type: size;
 }
 
