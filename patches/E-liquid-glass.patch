diff --git a/src/design-system/styles/components.css b/src/design-system/styles/components.css
index bba0c2d..9aa9a62 100644
--- a/src/design-system/styles/components.css
+++ b/src/design-system/styles/components.css
@@ -751,10 +751,25 @@
   margin: var(--space-2) var(--space-3) var(--safe-bottom);
   padding: 6px;
   border-radius: var(--radius-pill);
-  background: color-mix(in srgb, var(--color-surface) 88%, transparent);
-  -webkit-backdrop-filter: blur(16px) saturate(1.6);
-  backdrop-filter: blur(16px) saturate(1.6);
-  box-shadow: inset 0 0 0 var(--border-hairline) var(--color-border-subtle), var(--shadow-float);
+  /* Liquid Glass, menu tier: the bar floats over scrolling content (a real backdrop), and its icons
+     must stay legible over whatever slides under, so it is mostly blur plus a surface wash, with the
+     skill's rim (top highlight + hairline border). The wash is 72%, not the recipe's 55%: at 55%
+     section labels read through behind the icons. */
+  background: color-mix(in srgb, var(--color-surface) 72%, transparent);
+  -webkit-backdrop-filter: blur(22px) saturate(140%);
+  backdrop-filter: blur(22px) saturate(140%);
+  box-shadow:
+    inset 0 1px 0 var(--color-glass-rim),
+    inset 0 0 0 1px var(--color-glass-border),
+    var(--shadow-float);
+}
+
+@media (prefers-reduced-transparency: reduce) {
+  .tab-bar {
+    background: var(--color-surface);
+    -webkit-backdrop-filter: none;
+    backdrop-filter: none;
+  }
 }
 
 .tab-bar__item {
diff --git a/src/design-system/styles/content.css b/src/design-system/styles/content.css
index 2c16f25..08d8e30 100644
--- a/src/design-system/styles/content.css
+++ b/src/design-system/styles/content.css
@@ -753,6 +753,19 @@ button.list-row__hit:hover {
   box-shadow: var(--shadow-brand);
 }
 
+/* Liquid Glass, coloured-glass FAB recipe: SuperSwipe on the photo is tinted brand glass with the
+   skill's rim restated, so the photo shows through its edge. Strong tint keeps the white star at
+   3:1 or more over a light photo. The end-of-profile action bar keeps the solid fill. */
+.profile-card__actions .action-bar__btn--super {
+  background: linear-gradient(155deg, color-mix(in srgb, var(--color-brand) 86%, transparent), color-mix(in srgb, var(--color-brand) 74%, transparent));
+  -webkit-backdrop-filter: blur(3px) saturate(125%);
+  backdrop-filter: blur(3px) saturate(125%);
+  box-shadow:
+    0 12px 28px -8px color-mix(in srgb, var(--color-brand) 55%, transparent),
+    inset 0 1px 0 var(--color-glass-rim-color),
+    inset 0 0 0 1px color-mix(in srgb, var(--color-surface) 14%, transparent);
+}
+
 .action-bar__btn--super:active {
   box-shadow: none;
 }
