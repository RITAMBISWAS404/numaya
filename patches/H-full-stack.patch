 .fl-screen__body:has(+ .tab-bar) {
-  padding-bottom: var(--space-4);
+  padding-bottom: calc(var(--tab-bar-height) + var(--space-2) + var(--safe-bottom) + var(--space-4));
 }
 
 .fl-stack {
@@ -357,6 +364,13 @@ body {
   background: var(--color-surface-page);
 }
 
+/* UI/UX Pro Max Border role: cards on the tab screens take lavender hairlines instead of grey, so
+   every edge on the screen belongs to the brand family. (Its lavender page background is rejected:
+   it would erase Impeccable's lavender prompt object.) */
+.fl-screen--page:has(> .tab-bar) .card:not(.profile-section--prompt) {
+  box-shadow: inset 0 0 0 var(--border-hairline) var(--color-brand-subtle), var(--shadow-xs);
+}
+
 /* Messaging (Bumble layout, Meetup styling) ------------------------------- */
 .fl-close-head {
   flex: none;
@@ -563,7 +577,7 @@ body {
 
