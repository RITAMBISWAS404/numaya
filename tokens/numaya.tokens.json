{
  "$description": "Numaya design tokens. Single source of truth. Format: W3C Design Tokens Community Group (DTCG) draft, with CSS-compatible string values. Layers: primitive (raw values) → semantic (meaning) → component (explicit reusable needs). Build with `npm run tokens`; never edit generated files.",

  "primitive": {
    "$description": "Raw values. Never referenced directly by component CSS; use semantic or component tokens.",
    "color": {
      "blue": {
        "50":  { "$type": "color", "$value": "#eff6fd" },
        "100": { "$type": "color", "$value": "#e6f2fc" },
        "200": { "$type": "color", "$value": "#c6e1f7" },
        "300": { "$type": "color", "$value": "#9ccbf0" },
        "500": { "$type": "color", "$value": "#63afe9", "$description": "Numaya brand blue. Exact value; never substitute." },
        "600": { "$type": "color", "$value": "#3f92d4" },
        "700": { "$type": "color", "$value": "#1f6fb0", "$description": "Same hue as 500 (~207°). 5.3:1 on white." },
        "800": { "$type": "color", "$value": "#17507f" }
      },
      "neutral": {
        "0":   { "$type": "color", "$value": "#ffffff" },
        "50":  { "$type": "color", "$value": "#f3f5f8" },
        "100": { "$type": "color", "$value": "#eceff3" },
        "200": { "$type": "color", "$value": "#e7e9ed" },
        "300": { "$type": "color", "$value": "#d7dbe1" },
        "400": { "$type": "color", "$value": "#9aa1ac" },
        "450": { "$type": "color", "$value": "#8a919c" },
        "500": { "$type": "color", "$value": "#646b78" },
        "700": { "$type": "color", "$value": "#3a404c" },
        "750": { "$type": "color", "$value": "#353b48" },
        "800": { "$type": "color", "$value": "#2b303b" },
        "850": { "$type": "color", "$value": "#1a1d26" },
        "900": { "$type": "color", "$value": "#14171f" }
      },
      "red":   { "50": { "$type": "color", "$value": "#fdf0f2" }, "600": { "$type": "color", "$value": "#c8364f" } },
      "green": { "50": { "$type": "color", "$value": "#eaf7f0" }, "700": { "$type": "color", "$value": "#1b7f4e" } },
      "amber": { "50": { "$type": "color", "$value": "#fff6e5" }, "700": { "$type": "color", "$value": "#9a5b00" } },
      "alpha": {
        "ink-34":   { "$type": "color", "$value": "rgb(20 23 31 / 0.34)" },
        "ink-62":   { "$type": "color", "$value": "rgb(20 23 31 / 0.62)" },
        "blue-32":  { "$type": "color", "$value": "rgb(99 175 233 / 0.32)" },
        "white-55": { "$type": "color", "$value": "rgb(255 255 255 / 0.55)" }
      }
    },
    "font": {
      "family": {
        "fraunces": { "$type": "fontFamily", "$value": "\"Fraunces Variable\", ui-serif, Georgia, \"Times New Roman\", serif" },
        "inter":    { "$type": "fontFamily", "$value": "\"Inter Variable\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif" }
      },
      "size": {
        "11": { "$type": "dimension", "$value": "11px" },
        "12-5": { "$type": "dimension", "$value": "12.5px" },
        "13": { "$type": "dimension", "$value": "13px" },
        "13-5": { "$type": "dimension", "$value": "13.5px" },
        "15": { "$type": "dimension", "$value": "15px" },
        "15-5": { "$type": "dimension", "$value": "15.5px" },
        "16": { "$type": "dimension", "$value": "16px" },
        "18": { "$type": "dimension", "$value": "18px" },
        "20": { "$type": "dimension", "$value": "20px" },
        "23": { "$type": "dimension", "$value": "23px" },
        "26": { "$type": "dimension", "$value": "26px" },
        "31": { "$type": "dimension", "$value": "31px" },
        "34": { "$type": "dimension", "$value": "34px" }
      }
    },
    "dimension": {
      "0":  { "$type": "dimension", "$value": "0px" },
      "1":  { "$type": "dimension", "$value": "1px" },
      "2":  { "$type": "dimension", "$value": "2px" },
      "4":  { "$type": "dimension", "$value": "4px" },
      "6":  { "$type": "dimension", "$value": "6px" },
      "8":  { "$type": "dimension", "$value": "8px" },
      "10": { "$type": "dimension", "$value": "10px" },
      "12": { "$type": "dimension", "$value": "12px" },
      "14": { "$type": "dimension", "$value": "14px" },
      "16": { "$type": "dimension", "$value": "16px" },
      "18": { "$type": "dimension", "$value": "18px" },
      "20": { "$type": "dimension", "$value": "20px" },
      "22": { "$type": "dimension", "$value": "22px" },
      "24": { "$type": "dimension", "$value": "24px" },
      "28": { "$type": "dimension", "$value": "28px" },
      "32": { "$type": "dimension", "$value": "32px" },
      "36": { "$type": "dimension", "$value": "36px" },
      "40": { "$type": "dimension", "$value": "40px" },
      "44": { "$type": "dimension", "$value": "44px" },
      "48": { "$type": "dimension", "$value": "48px" },
      "54": { "$type": "dimension", "$value": "54px" },
      "56": { "$type": "dimension", "$value": "56px" },
      "60": { "$type": "dimension", "$value": "60px" },
      "64": { "$type": "dimension", "$value": "64px" },
      "96": { "$type": "dimension", "$value": "96px" }
    },
    "duration": {
      "140": { "$type": "duration", "$value": "140ms" },
      "220": { "$type": "duration", "$value": "220ms" },
      "380": { "$type": "duration", "$value": "380ms" },
      "460": { "$type": "duration", "$value": "460ms" }
    },
    "easing": {
      "out-quint": { "$type": "cubicBezier", "$value": "cubic-bezier(0.22, 1, 0.36, 1)" },
      "ios":       { "$type": "cubicBezier", "$value": "cubic-bezier(0.32, 0.72, 0, 1)" },
      "in-out":    { "$type": "cubicBezier", "$value": "cubic-bezier(0.65, 0, 0.35, 1)" }
    }
  },

  "semantic": {
    "$description": "The public API for product UI. Names describe intent, not appearance.",
    "color": {
      "brand": {
        "default": { "$type": "color", "$value": "{primitive.color.blue.500}", "$description": "Brand accent #63AFE9: marks, progress, focus, selected, verified, brand fills. Foreground on it must be color.on-brand." },
        "pressed": { "$type": "color", "$value": "{primitive.color.blue.600}", "$description": "Pressed state of brand-filled controls only." },
        "strong":  { "$type": "color", "$value": "{primitive.color.blue.700}", "$description": "Contrast-sensitive fill: use only when a blue-filled control must carry white body-size text (≥ 4.5:1). Never a replacement for brand.default." },
        "tint":    { "$type": "color", "$value": "{primitive.color.blue.100}", "$description": "Light brand surface for selected and highlighted states; dark text allowed." },
        "subtle":  { "$type": "color", "$value": "{primitive.color.blue.200}", "$description": "Brand-tinted borders and halos." }
      },
      "on-brand": { "$type": "color", "$value": "{primitive.color.neutral.0}", "$description": "Foreground on any solid blue fill. Always white." },
      "text": {
        "primary":    { "$type": "color", "$value": "{primitive.color.neutral.900}" },
        "secondary":  { "$type": "color", "$value": "{primitive.color.neutral.700}" },
        "muted":      { "$type": "color", "$value": "{primitive.color.neutral.500}", "$description": "Body copy, ledes, meta. 5.2:1 on white." },
        "subtle":     { "$type": "color", "$value": "{primitive.color.neutral.400}", "$description": "Placeholders and disabled labels only (2.6:1, documented exception)." },
        "brand":      { "$type": "color", "$value": "{primitive.color.blue.700}", "$description": "Brand-coloured text: links, emphasis, labels on light surfaces. 5.3:1." },
        "brand-deep": { "$type": "color", "$value": "{primitive.color.blue.800}", "$description": "Text on brand.tint surfaces." },
        "brand-display": { "$type": "color", "$value": "{primitive.color.blue.500}", "$description": "Exact brand #63AFE9 for brand-highlighted display words (≥ 26px headline emphasis, e.g. welcome \"Better\"). 2.38:1 on white: documented exception, one word per headline, never body text." },
        "on-inverse": { "$type": "color", "$value": "{primitive.color.neutral.0}" }
      },
      "surface": {
        "default": { "$type": "color", "$value": "{primitive.color.neutral.0}" },
        "soft":    { "$type": "color", "$value": "{primitive.color.neutral.50}", "$description": "Fields and quiet fills." },
        "sunken":  { "$type": "color", "$value": "{primitive.color.neutral.100}", "$description": "Tracks, disabled fills, hover on soft." },
        "canvas":  { "$type": "color", "$value": "{primitive.color.neutral.100}", "$description": "Background behind app frames and showcase pages." },
        "brand":   { "$type": "color", "$value": "{primitive.color.blue.50}", "$description": "Brand-washed screen backgrounds (welcome)." },
        "inverse": { "$type": "color", "$value": "{primitive.color.neutral.900}", "$description": "Ink fills: primary actions, toasts." }
      },
      "border": {
        "subtle":  { "$type": "color", "$value": "{primitive.color.neutral.200}" },
        "strong":  { "$type": "color", "$value": "{primitive.color.neutral.300}" },
        "brand":   { "$type": "color", "$value": "{primitive.color.blue.500}" },
        "control": { "$type": "color", "$value": "{primitive.color.neutral.450}", "$description": "Outlines of unchecked checkboxes, radios and switches (3.2:1, meets non-text contrast)." }
      },
      "focus": {
        "ring": { "$type": "color", "$value": "{primitive.color.blue.500}" },
        "halo": { "$type": "color", "$value": "{primitive.color.alpha.blue-32}" }
      },
      "overlay": {
        "scrim": { "$type": "color", "$value": "{primitive.color.alpha.ink-34}" },
        "hover-light": { "$type": "color", "$value": "{primitive.color.alpha.white-55}" },
        "photo": { "$type": "color", "$value": "{primitive.color.alpha.ink-62}", "$description": "Bottom legibility overlay for text on photos (functional, not decorative)." }
      },
      "danger":  { "default": { "$type": "color", "$value": "{primitive.color.red.600}" },   "tint": { "$type": "color", "$value": "{primitive.color.red.50}" } },
      "success": { "default": { "$type": "color", "$value": "{primitive.color.green.700}" }, "tint": { "$type": "color", "$value": "{primitive.color.green.50}" } },
      "warning": { "default": { "$type": "color", "$value": "{primitive.color.amber.700}" }, "tint": { "$type": "color", "$value": "{primitive.color.amber.50}" } }
    },

    "font": {
      "display": { "$type": "fontFamily", "$value": "{primitive.font.family.fraunces}", "$description": "Headlines, wordmark, prompt answers, sheet titles." },
      "text":    { "$type": "fontFamily", "$value": "{primitive.font.family.inter}", "$description": "Body, labels, inputs, buttons, numerals." },
      "display-axes": { "$type": "other", "$value": "\"SOFT\" 50, \"WONK\" 0", "$description": "font-variation-settings for Fraunces." },
      "weight": {
        "regular":  { "$type": "fontWeight", "$value": "400" },
        "medium":   { "$type": "fontWeight", "$value": "500" },
        "semibold": { "$type": "fontWeight", "$value": "600" },
        "bold":     { "$type": "fontWeight", "$value": "680" }
      }
    },

    "type": {
      "$description": "Typographic roles. Each role has size, line, weight, tracking. Family: hero/display/headline/title use font.display; the rest use font.text.",
      "hero":     { "size": { "$type": "dimension", "$value": "{primitive.font.size.34}" }, "line": { "$type": "dimension", "$value": "38px" }, "weight": { "$type": "fontWeight", "$value": "440" }, "tracking": { "$type": "dimension", "$value": "-0.022em" } },
      "display":  { "size": { "$type": "dimension", "$value": "{primitive.font.size.31}" }, "line": { "$type": "dimension", "$value": "35px" }, "weight": { "$type": "fontWeight", "$value": "440" }, "tracking": { "$type": "dimension", "$value": "-0.02em" } },
      "headline": { "size": { "$type": "dimension", "$value": "{primitive.font.size.26}" }, "line": { "$type": "dimension", "$value": "30px" }, "weight": { "$type": "fontWeight", "$value": "440" }, "tracking": { "$type": "dimension", "$value": "-0.02em" } },
      "title":    { "size": { "$type": "dimension", "$value": "{primitive.font.size.20}" }, "line": { "$type": "dimension", "$value": "25px" }, "weight": { "$type": "fontWeight", "$value": "450" }, "tracking": { "$type": "dimension", "$value": "-0.012em" } },
      "title-sm": { "size": { "$type": "dimension", "$value": "{primitive.font.size.23}" }, "line": { "$type": "dimension", "$value": "28px" }, "weight": { "$type": "fontWeight", "$value": "450" }, "tracking": { "$type": "dimension", "$value": "-0.015em" }, "$description": "Sheet and dialog titles." },
      "body":     { "size": { "$type": "dimension", "$value": "{primitive.font.size.15-5}" }, "line": { "$type": "dimension", "$value": "23px" }, "weight": { "$type": "fontWeight", "$value": "400" }, "tracking": { "$type": "dimension", "$value": "-0.006em" } },
      "body-sm":  { "size": { "$type": "dimension", "$value": "{primitive.font.size.15}" }, "line": { "$type": "dimension", "$value": "21px" }, "weight": { "$type": "fontWeight", "$value": "400" }, "tracking": { "$type": "dimension", "$value": "-0.006em" } },
      "input":    { "size": { "$type": "dimension", "$value": "{primitive.font.size.18}" }, "line": { "$type": "dimension", "$value": "24px" }, "weight": { "$type": "fontWeight", "$value": "500" }, "tracking": { "$type": "dimension", "$value": "0em" } },
      "button":   { "size": { "$type": "dimension", "$value": "{primitive.font.size.16}" }, "line": { "$type": "dimension", "$value": "20px" }, "weight": { "$type": "fontWeight", "$value": "600" }, "tracking": { "$type": "dimension", "$value": "-0.01em" } },
      "label":    { "size": { "$type": "dimension", "$value": "{primitive.font.size.13-5}" }, "line": { "$type": "dimension", "$value": "18px" }, "weight": { "$type": "fontWeight", "$value": "500" }, "tracking": { "$type": "dimension", "$value": "0em" } },
      "caption":  { "size": { "$type": "dimension", "$value": "{primitive.font.size.13}" }, "line": { "$type": "dimension", "$value": "18px" }, "weight": { "$type": "fontWeight", "$value": "400" }, "tracking": { "$type": "dimension", "$value": "0em" } },
      "micro":    { "size": { "$type": "dimension", "$value": "{primitive.font.size.12-5}" }, "line": { "$type": "dimension", "$value": "17px" }, "weight": { "$type": "fontWeight", "$value": "400" }, "tracking": { "$type": "dimension", "$value": "0em" } },
      "eyebrow":  { "size": { "$type": "dimension", "$value": "{primitive.font.size.11}" }, "line": { "$type": "dimension", "$value": "14px" }, "weight": { "$type": "fontWeight", "$value": "600" }, "tracking": { "$type": "dimension", "$value": "0.12em" } }
    },

    "space": {
      "$description": "4-point spacing scale.",
      "0":  { "$type": "dimension", "$value": "{primitive.dimension.0}" },
      "1":  { "$type": "dimension", "$value": "{primitive.dimension.4}" },
      "2":  { "$type": "dimension", "$value": "{primitive.dimension.8}" },
      "3":  { "$type": "dimension", "$value": "{primitive.dimension.12}" },
      "4":  { "$type": "dimension", "$value": "{primitive.dimension.16}" },
      "5":  { "$type": "dimension", "$value": "{primitive.dimension.20}" },
      "6":  { "$type": "dimension", "$value": "{primitive.dimension.24}" },
      "7":  { "$type": "dimension", "$value": "{primitive.dimension.28}" },
      "8":  { "$type": "dimension", "$value": "{primitive.dimension.32}" },
      "10": { "$type": "dimension", "$value": "{primitive.dimension.40}" },
      "12": { "$type": "dimension", "$value": "{primitive.dimension.48}" }
    },
    "layout": {
      "gutter":      { "$type": "dimension", "$value": "{primitive.dimension.24}", "$description": "Screen side padding." },
      "gutter-tight":{ "$type": "dimension", "$value": "{primitive.dimension.16}", "$description": "Dense lists, top bars." },
      "content-max": { "$type": "dimension", "$value": "430px", "$description": "Max content width on phones; wider viewports centre the column." },
      "stack-gap":   { "$type": "dimension", "$value": "{primitive.dimension.12}", "$description": "Gap between stacked controls." },
      "section-gap": { "$type": "dimension", "$value": "{primitive.dimension.32}", "$description": "Gap between content sections." }
    },
    "size": {
      "control":     { "$type": "dimension", "$value": "{primitive.dimension.56}", "$description": "Text input height." },
      "touch-min":   { "$type": "dimension", "$value": "{primitive.dimension.44}", "$description": "Minimum touch target." },
      "icon-sm":     { "$type": "dimension", "$value": "{primitive.dimension.16}" },
      "icon-md":     { "$type": "dimension", "$value": "{primitive.dimension.20}" },
      "icon-lg":     { "$type": "dimension", "$value": "{primitive.dimension.24}" },
      "avatar-xs":   { "$type": "dimension", "$value": "{primitive.dimension.24}" },
      "avatar-sm":   { "$type": "dimension", "$value": "{primitive.dimension.36}" },
      "avatar-md":   { "$type": "dimension", "$value": "{primitive.dimension.48}" },
      "avatar-lg":   { "$type": "dimension", "$value": "{primitive.dimension.64}" },
      "avatar-xl":   { "$type": "dimension", "$value": "{primitive.dimension.96}" }
    },
    "icon": {
      "stroke":      { "$type": "number", "$value": "1.75", "$description": "Default icon stroke width (24px grid)." },
      "stroke-bold": { "$type": "number", "$value": "2", "$description": "Icons inside filled buttons and small sizes." }
    },
    "radius": {
      "xs":   { "$type": "dimension", "$value": "{primitive.dimension.8}" },
      "sm":   { "$type": "dimension", "$value": "{primitive.dimension.12}" },
      "md":   { "$type": "dimension", "$value": "{primitive.dimension.16}" },
      "lg":   { "$type": "dimension", "$value": "{primitive.dimension.20}" },
      "xl":   { "$type": "dimension", "$value": "{primitive.dimension.28}" },
      "2xl":  { "$type": "dimension", "$value": "{primitive.dimension.32}" },
      "pill": { "$type": "dimension", "$value": "999px" }
    },
    "border": {
      "hairline": { "$type": "dimension", "$value": "{primitive.dimension.1}" },
      "selected": { "$type": "dimension", "$value": "1.5px" },
      "focus":    { "$type": "dimension", "$value": "{primitive.dimension.2}" }
    },
    "shadow": {
      "xs":     { "$type": "shadow", "$value": "0 1px 2px rgb(20 23 31 / 0.04)", "$description": "Resting lift for outlined controls and selected rows." },
      "float":  { "$type": "shadow", "$value": "0 1px 2px rgb(20 23 31 / 0.05), 0 6px 18px rgb(20 23 31 / 0.07), inset 0 0 0 1px rgb(20 23 31 / 0.04)", "$description": "Floating chrome: nav buttons over content." },
      "card":   { "$type": "shadow", "$value": "0 1px 2px rgb(20 23 31 / 0.04), 0 14px 34px -10px rgb(20 23 31 / 0.16), inset 0 0 0 1px rgb(20 23 31 / 0.05)", "$description": "Raised content cards (prompt, discovery)." },
      "button": { "$type": "shadow", "$value": "inset 0 1px 0 rgb(255 255 255 / 0.14), inset 0 -1px 0 rgb(0 0 0 / 0.3), 0 1px 2px rgb(20 23 31 / 0.18), 0 8px 18px -6px rgb(20 23 31 / 0.38)" },
      "sheet":  { "$type": "shadow", "$value": "0 -1px 0 rgb(20 23 31 / 0.04), 0 -18px 48px -12px rgb(20 23 31 / 0.18)" },
      "toast":  { "$type": "shadow", "$value": "0 12px 30px -10px rgb(20 23 31 / 0.5)" },
      "brand":  { "$type": "shadow", "$value": "0 8px 20px -6px rgb(31 111 176 / 0.45)", "$description": "Lift under brand-filled marks." },
      "knob":   { "$type": "shadow", "$value": "0 2px 4px rgb(20 23 31 / 0.18)", "$description": "Switch knob." },
      "thumb":  { "$type": "shadow", "$value": "0 1px 2px rgb(20 23 31 / 0.04), 0 2px 6px rgb(20 23 31 / 0.16)", "$description": "Slider thumbs." },
      "segment":{ "$type": "shadow", "$value": "0 1px 2px rgb(20 23 31 / 0.04), 0 2px 6px rgb(20 23 31 / 0.06)", "$description": "Selected segment in a segmented control." },
      "panel":  { "$type": "shadow", "$value": "0 -1px 0 rgb(20 23 31 / 0.04), 0 -24px 48px -28px rgb(20 23 31 / 0.18)" }
    },
    "opacity": {
      "disabled": { "$type": "number", "$value": "0.45" },
      "pending":  { "$type": "number", "$value": "0.55", "$description": "Content locked while a request is checking." }
    },
    "z": {
      "raised":  { "$type": "number", "$value": "1" },
      "sticky":  { "$type": "number", "$value": "5" },
      "overlay": { "$type": "number", "$value": "10" },
      "toast":   { "$type": "number", "$value": "20" }
    },
    "motion": {
      "duration": {
        "fast": { "$type": "duration", "$value": "{primitive.duration.140}", "$extensions": { "numaya": { "reducedMotion": "1ms" } } },
        "base": { "$type": "duration", "$value": "{primitive.duration.220}", "$extensions": { "numaya": { "reducedMotion": "1ms" } } },
        "slow": { "$type": "duration", "$value": "{primitive.duration.380}", "$extensions": { "numaya": { "reducedMotion": "120ms" } } },
        "push": { "$type": "duration", "$value": "{primitive.duration.460}", "$extensions": { "numaya": { "reducedMotion": "160ms" } }, "$description": "Screen push/pop, sheets, keyboard." }
      },
      "ease": {
        "out":        { "$type": "cubicBezier", "$value": "{primitive.easing.out-quint}", "$description": "Default for entering and state changes." },
        "emphasized": { "$type": "cubicBezier", "$value": "{primitive.easing.ios}", "$description": "Navigation, sheets." },
        "in-out":     { "$type": "cubicBezier", "$value": "{primitive.easing.in-out}", "$description": "Exits." }
      }
    }
  },

  "component": {
    "$description": "Only for explicit reusable needs that semantic tokens cannot express.",
    "button": {
      "height":       { "$type": "dimension", "$value": "{primitive.dimension.54}" },
      "height-sm":    { "$type": "dimension", "$value": "{primitive.dimension.40}" },
      "height-quiet": { "$type": "dimension", "$value": "{primitive.dimension.48}" },
      "primary": {
        "bg-top":          { "$type": "color", "$value": "{primitive.color.neutral.800}" },
        "bg-bottom":       { "$type": "color", "$value": "{semantic.color.surface.inverse}" },
        "bg-hover-top":    { "$type": "color", "$value": "{primitive.color.neutral.750}" },
        "bg-hover-bottom": { "$type": "color", "$value": "{primitive.color.neutral.850}" }
      }
    },
    "fab":         { "size": { "$type": "dimension", "$value": "{primitive.dimension.56}" } },
    "icon-button": { "size": { "$type": "dimension", "$value": "{primitive.dimension.40}" }, "size-sm": { "$type": "dimension", "$value": "{primitive.dimension.36}" } },
    "chip":        { "height": { "$type": "dimension", "$value": "{primitive.dimension.36}" } },
    "progress":    { "segment-width": { "$type": "dimension", "$value": "{primitive.dimension.18}" }, "segment-height": { "$type": "dimension", "$value": "{primitive.dimension.8}" } },
    "code-cell":   { "height": { "$type": "dimension", "$value": "{primitive.dimension.60}" }, "radius": { "$type": "dimension", "$value": "{primitive.dimension.14}" } },
    "switch":      { "width": { "$type": "dimension", "$value": "51px" }, "height": { "$type": "dimension", "$value": "31px" } },
    "tab-bar":     { "height": { "$type": "dimension", "$value": "{primitive.dimension.56}" } }
  }
}
