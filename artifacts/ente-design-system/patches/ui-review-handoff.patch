+      expect(
+        tester.getSize(find.byType(NumayaButton)).height,
+        AppSizes.buttonHeight,
+      );
+    });
+
+    testWidgets('prompt card: small label above a dominant answer, no icon', (
+      tester,
+    ) async {
+      await tester.pumpWidget(
+        const MaterialApp(
